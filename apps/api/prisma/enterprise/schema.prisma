generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/enterprise"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["enterprise"]
}

model Organization {
  id                  String   @id @default(uuid())
  taxCode             String   @unique
  name                String
  shortName           String?
  businessType        String
  headquartersAddress String

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users               User[]
  parties             Party[]
  debtRecords         DebtRecord[]
  auditLogs           AuditLog[]

  @@map("enterprise_organizations")
  @@schema("enterprise")
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  passwordHash     String
  fullName         String
  roleTitle        String   
  phoneNumber      String

  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])

  managedParties   Party[]      @relation("PersonInCharge")
  managedDebts     DebtRecord[] @relation("DebtPersonInCharge")
  notifications    Notification[]
  auditLogs        AuditLog[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("enterprise_users")
  @@schema("enterprise")
}

model Party {
  id             String   @id @default(uuid())
  taxCode        String?  
  name           String
  shortName      String?
  internalCode   String   
  typeTags       String[] // CUSTOMER, SUPPLIER, BANK, STATE, INTERNAL
  isRelatedParty Boolean  @default(false)
  creditLimit    Float    @default(0)
  status         String   @default("ACTIVE") // ACTIVE, INACTIVE, BLACKLIST

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  personInChargeId String?
  personInCharge   User? @relation("PersonInCharge", fields: [personInChargeId], references: [id])

  parentId       String?
  parent         Party?   @relation("PartnerGroup", fields: [parentId], references: [id])
  children       Party[]  @relation("PartnerGroup")

  contacts       Contact[]
  bankAccounts   BankAccount[]
  
  debtRecords    DebtRecord[]
  guaranteedDebts DebtRecord[] @relation("DebtGuarantor")
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, taxCode])
  @@unique([organizationId, internalCode])
  @@map("enterprise_parties")
  @@schema("enterprise")
}

model Contact {
  id        String   @id @default(uuid())
  partyId   String
  party     Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  name      String
  position  String?
  email     String?
  phone     String?
  isPrimary Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("enterprise_contacts")
  @@schema("enterprise")
}

model BankAccount {
  id            String   @id @default(uuid())
  partyId       String
  party         Party    @relation(fields: [partyId], references: [id], onDelete: Cascade)
  bankName      String
  accountNumber String
  accountHolder String
  branch        String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("enterprise_bank_accounts")
  @@schema("enterprise")
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  action         String   // CREATE, UPDATE, DELETE, TOGGLE_STATUS
  entityType     String   // PARTY, CONTACT, BANK_ACCOUNT, DEBT_RECORD
  entityId       String
  oldValues      Json?
  newValues      Json?
  reason         String?

  createdAt      DateTime @default(now())

  @@map("enterprise_audit_logs")
  @@schema("enterprise")
}

model DebtRecord {
  id               String   @id @default(uuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  
  partyId          String
  party            Party    @relation(fields: [partyId], references: [id])
  
  guarantorId      String?
  guarantor        Party?   @relation("DebtGuarantor", fields: [guarantorId], references: [id])
  
  type             String   // RECEIVABLE, PAYABLE
  origin           String   // TRADE, FINANCIAL, TAX, BOND, INTERNAL
  
  principal        Float
  outstanding      Float    @default(0) // Current principal remaining
  interestMethod   String   // REDUCING_BALANCE, EMI, BULLET, NONE
  
  issueDate        DateTime
  dueDate          DateTime // Final due date
  
  status           String   @default("DRAFT") // DRAFT, ACTIVE, PARTIAL, PAID, OVERDUE, DISPUTED, WRITTEN_OFF
  
  // Module 5: Overdue & Penalty tracking
  overdueSince          DateTime? // First date debt became overdue
  lastOverdueCheckDate  DateTime? // Idempotency: last date Job 1 processed this record
  lastPenaltyDate       DateTime? // Idempotency: last date Job 2 calculated penalty
  penaltyRate           Float     @default(0)   // %/day (e.g. 0.0003 = 0.03%)
  gracePeriodDays       Int       @default(0)   // Days after dueDate before penalty starts
  
  personInChargeId String?
  personInCharge   User? @relation("DebtPersonInCharge", fields: [personInChargeId], references: [id])
  
  internalCode     String?  // Reference number
  notes            String?  @db.Text
  
  interestRates    DebtInterestRate[]
  schedules        DebtSchedule[]
  transactions     DebtTransaction[]
  documents        DebtDocument[]
  notifications    Notification[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("enterprise_debt_records")
  @@schema("enterprise")
}

model DebtInterestRate {
  id           String   @id @default(uuid())
  debtRecordId String
  debtRecord   DebtRecord @relation(fields: [debtRecordId], references: [id], onDelete: Cascade)
  
  rate         Float    // Percentage (e.g. 8.5)
  effectiveDate DateTime // When this rate starts being active
  
  createdAt    DateTime @default(now())

  @@map("enterprise_debt_interest_rates")
  @@schema("enterprise")
}

model DebtSchedule {
  id             String   @id @default(uuid())
  debtRecordId   String
  debtRecord     DebtRecord @relation(fields: [debtRecordId], references: [id], onDelete: Cascade)
  
  period         Int      // Sequence number
  dueDate        DateTime
  
  principalAmount Float
  interestAmount Float
  totalAmount    Float
  
  paidPrincipal  Float    @default(0)
  paidInterest   Float    @default(0)
  
  remainingPrincipal Float // Balance after this payment
  
  status         String   @default("PENDING") // PENDING, PAID, PARTIAL, OVERDUE
  isOverdue      Boolean  @default(false)
  overdueSince   DateTime?
  
  triggerType    String   @default("DATE") // DATE, MILESTONE
  triggerCondition String? // e.g. "ACCEPTANCE", "WARRANTY_END"
  isActivated    Boolean  @default(true) // For milestone-based, initially false
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("enterprise_debt_schedules")
  @@schema("enterprise")
}

model DebtTransaction {
  id             String   @id @default(uuid())
  debtRecordId   String
  debtRecord     DebtRecord @relation(fields: [debtRecordId], references: [id], onDelete: Cascade)
  
  type           String   // PAYMENT, PENALTY, INTEREST, ADJUSTMENT, REVERSAL
  amount         Float
  principalPart  Float    @default(0)
  interestPart   Float    @default(0)
  penaltyPart    Float    @default(0)
  
  paidAt         DateTime @default(now())
  paymentMethod  String?  // CASH, BANK_TRANSFER, OFFSET
  reference      String?  // Receipt or Transaction ID
  notes          String?  @db.Text
  
  balanceSnapshot Float    @default(0) // Outstanding principal AFTER this transaction
  
  reversesTransactionId String?
  reversesTransaction   DebtTransaction? @relation("TransactionReversal", fields: [reversesTransactionId], references: [id])
  reversedBy            DebtTransaction[] @relation("TransactionReversal")
  
  createdAt      DateTime @default(now())

  @@map("enterprise_debt_transactions")
  @@schema("enterprise")
}

model DebtDocument {
  id             String   @id @default(uuid())
  debtRecordId   String
  debtRecord     DebtRecord @relation(fields: [debtRecordId], references: [id], onDelete: Cascade)
  
  name           String
  fileUrl        String
  fileType       String?
  fileSize       Int?
  
  createdAt      DateTime @default(now())

  @@map("enterprise_debt_documents")
  @@schema("enterprise")
}

model JobLog {
  id             String   @id @default(uuid())
  organizationId String?
  jobName        String   // JOB_OVERDUE, JOB_PENALTY, JOB_NOTIFY, JOB_REPORT
  runAt          DateTime @default(now())
  status         String   // RUNNING, SUCCESS, FAILED, PARTIAL
  processedCount Int      @default(0)
  failedCount    Int      @default(0)
  errorLog       String?  @db.Text
  durationMs     Int?
  details        Json?    // Added this for flexible report data

  @@map("enterprise_job_logs")
  @@schema("enterprise")
}

model Notification {
  id             String   @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  targetUserId   String
  targetUser     User     @relation(fields: [targetUserId], references: [id])
  
  type           String   // TIME_BASED, EVENT_BASED
  category       String   // OVERDUE, PENALTY, PAYMENT, NEW_DEBT, ESCALATION, LIMIT_BREACH
  priority       String   @default("INFO") // URGENT, IMPORTANT, REMINDER, INFO
  
  title          String
  content        String   @db.Text
  data           Json?    // { debtId, partyId, amount, ... }
  
  isRead         Boolean  @default(false)
  readAt         DateTime?
  
  acknowledgedAt DateTime?
  snoozedUntil   DateTime?
  
  debtRecordId   String?
  debtRecord     DebtRecord? @relation(fields: [debtRecordId], references: [id])
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("enterprise_notifications")
  @@schema("enterprise")
}
